# Perfil de produção. Sem configuração, a aplicação usa o perfil dev.
SPRING_PROFILES_ACTIVE=prod

# Banco PostgreSQL existente e usuário com permissão para aplicar as migrações.
DB_URL=jdbc:postgresql://localhost:5432/avaliacao_curricular
DB_USERNAME=avaliacao
DB_PASSWORD=''

# Conta da coordenação. Preencha a senha antes de carregar o arquivo.
APP_ADMIN_USERNAME=coordenacao
APP_ADMIN_PASSWORD=''
